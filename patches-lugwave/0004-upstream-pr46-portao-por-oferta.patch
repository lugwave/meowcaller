+// HookError reports whether the library could install its handlers into the wrapped
+// whatsmeow client. It reaches an unexported part of whatsmeow, so a whatsmeow
+// update can break it: when the error is not nil, inbound offers still arrive as
+// whatsmeow events but outbound calls and relay allocation do not work, and a
+// caller should treat calls as unavailable.
+func (c *Client) HookError() error {
+	return c.eng.requireRawCallAdapter()
+}
+
 // OnIncomingCall registers the listener fired for each inbound call offer. The handler
 // receives a Call that has not been answered yet; call Answer or Reject on it. Only the
 // most recently registered listener is used.
diff --git a/engine.go b/engine.go
index b0c628f..cb82518 100644
--- a/engine.go
+++ b/engine.go
@@ -559,6 +559,18 @@ func (e *engine) onOffer(ev *events.CallOffer) {
 		e.c.log.Warn().Err(groupErr).Str("call_id", ev.CallID).Msg("parse inbound group offer failed")
 		return
 	}
+	// The gate runs before anything is decrypted or sent: a refused offer leaves this
+	// device exactly as silent as a whatsmeow client without a call stack.
+	if gate := e.c.offerGate; gate != nil {
+		offer := Offer{
+			CallID: ev.CallID, From: ev.From, Creator: ev.CallCreator,
+			Group: isGroup, Video: signaling.OfferHasVideo(ev.Data),
+		}
+		if !gate(offer) {
+			e.c.log.Debug().Str("call_id", ev.CallID).Msg("offer refused by the offer gate; not engaging")
+			return
+		}
+	}
 	if isGroup {
 		e.onGroupOffer(ev, groupCallUpdateFromSignaling(*groupSnapshot))
 		return
