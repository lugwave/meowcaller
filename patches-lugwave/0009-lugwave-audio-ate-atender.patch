+// earlyModeFor is what an inbound 1:1 offer sends before Answer: the host's choice
+// (WithInboundEarlyMedia), or EarlyMediaHoldAudio without one.
+func (e *engine) earlyModeFor(o Offer) EarlyMediaMode {
+	if e.c != nil && e.c.earlyMedia != nil {
+		return e.c.earlyMedia(o)
+	}
+	return EarlyMediaHoldAudio
